Es scheint dass rules.mk und config.h nicht richtig tun deswegen alles mit kommandozeilenoptionen setzen.
1. alles aus - tut 
qmk clean -a && qmk compile -kb kbdfans/bella/rgb_iso -km neo \
  -e 'EXTRAFLAGS=-Wno-error' \
  -e 'VIA_ENABLE=no KEYMAP_INTROSPECTION_ENABLE=no RAW_ENABLE=no MAGIC_ENABLE=no DYNAMIC_MACRO_ENABLE=no GRAVE_ESC_ENABLE=no SPACE_CADET_ENABLE=no UNICODE_ENABLE=no RGB_MATRIX_ENABLE=no RGBLIGHT_ENABLE=no NKRO_ENABLE=no CONSOLE_ENABLE=no COMMAND_ENABLE=no'

2. dann wieder einschalten was geht:
qmk clean -a && qmk compile -kb kbdfans/bella/rgb_iso -km neo \
      -e 'EXTRAFLAGS=-Wno-error -DDYNAMIC_KEYMAP_LAYER_COUNT=0 -DDYNAMIC_KEYMAP_MACRO_COUNT=4 -DDYNAMIC_KEYMAP_MACRO_MAX_LENGTH=32 -DVIA_EEPROM_LAYOUT_OPTIONS_SIZE=0' \
  -e 'VIA_ENABLE=yes KEYMAP_INTROSPECTION_ENABLE=no RAW_ENABLE=yes DYNAMIC_KEYMAP_ENABLE=yes MAGIC_ENABLE=no DYNAMIC_MACRO_ENABLE=no GRAVE_ESC_ENABLE=no SPACE_CADET_ENABLE=no RGB_MATRIX_ENABLE=no RGBLIGHT_ENABLE=no NKRO_ENABLE=no CONSOLE_ENABLE=no COMMAND_ENABLE=no'
